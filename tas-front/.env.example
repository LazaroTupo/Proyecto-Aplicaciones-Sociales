# ==========================================
# Configuración del Servidor Next.js
# ==========================================
# Puerto por defecto para evitar colisiones con NestJS
PORT=3001
NODE_ENV=development

# ==========================================
# Endpoints de API (Backend NestJS)
# ==========================================
# Base URL usada por Axios en el frontend para consumir la API
NEXT_PUBLIC_API_URL=http://localhost:3000

# ==========================================
# Configuración de Pasarelas y WebSockets
# ==========================================
# URL para la conexión de Socket.io (Módulo de Notificaciones)
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Ejemplo: Clientes de pagos o analíticas (Descomentar y llenar si es necesario)
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb-ejemplo-client-id
